{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "functions": {
    "api/sync/ads.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/sync/ads?run=request", "schedule": "0 13 * * *" },
    { "path": "/api/sync/ads?run=collect", "schedule": "0 14 * * *" }
  ]
}
