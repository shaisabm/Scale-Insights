{
  // Type-checks the plain browser scripts in src/ without compiling them.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "types/**/*.d.ts"]
}
