# Copy to .env.local and fill in, or run `vercel env pull` for the Development values.
# Server-side secrets: never read them from app/src, which is served publicly.
# Which accounts may be written to: see "Amazon APIs" in CLAUDE.md.

# Amazon Selling Partner API (SP-API), Login with Amazon app credentials
SP_API_SANDBOX_CLIENT_ID=
SP_API_SANDBOX_CLIENT_SECRET=
SP_API_PROD_CLIENT_ID=
SP_API_PROD_CLIENT_SECRET=

# Amazon Ads API
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
# Separate test login that manages no real ad accounts, for Ads test accounts only
AMAZON_ADS_TEST_REFRESH_TOKEN=
# Real US profile (reads only) and the test account's profile
AMAZON_ADS_PROFILE_ID=
AMAZON_ADS_TEST_PROFILE_ID=

# Turso database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Site sign-in and scheduled sync
APP_PASSWORD=
SESSION_SECRET=
CRON_SECRET=
